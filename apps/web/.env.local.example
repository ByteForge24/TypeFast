# WebSocket Server Connection
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Database Connection (local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/typefast?schema=public

# NextAuth Configuration
NEXTAUTH_SECRET=dev-secret-key-change-in-production-1234567890
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional - leave empty to skip Google sign-in)
# Generate from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Service (optional - required for signup verification)
# Get API key from: https://resend.com/
RESEND_API_KEY=

# Frontend URL for verification emails
FRONTEND_URL=http://localhost:3000

# Redis Cache (local Redis)
REDIS_URL=redis://localhost:6379
