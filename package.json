{
  "name": "typefast",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "cd apps/web/DB_prisma && npx prisma generate || true",
    "build": "turbo build",
    "web:build": "cd apps/web && yarn build",
    "start": "cd apps/web && yarn start",
    "dev": "turbo dev",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "lint": "turbo lint",
    "lint:fix": "turbo lint --fix",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "ws:dev": "yarn workspace @typefast/ws dev",
    "ws:build": "yarn workspace @typefast/ws build",
    "ws:start": "yarn workspace @typefast/ws start"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.2.5",
    "turbo": "^2.3.3",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.3",
    "prisma": "^6.15.0"
  },
  "engines": {
    "node": ">=18"
  }
}
